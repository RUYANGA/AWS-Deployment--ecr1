# Django
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.dev
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# API docs (Swagger UI, ReDoc, OpenAPI schema). Set to False in production.
ENABLE_API_DOCS=True

# PostgreSQL
POSTGRES_DB=logistic_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Connection pool (per process): connections kept open, max open, seconds to wait
POSTGRES_POOL_MIN_SIZE=2
POSTGRES_POOL_MAX_SIZE=20
POSTGRES_POOL_TIMEOUT=60

# Email (console backend prints emails to the terminal; use SMTP in production)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=email-smtp.eu-west-1.amazonaws.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Logistic <no-reply@localhost>

# Email verification codes (OTP)
EMAIL_OTP_TTL_MINUTES=10
EMAIL_OTP_RESEND_COOLDOWN_SECONDS=60
EMAIL_OTP_MAX_ATTEMPTS=5

# JWT
ACCESS_TOKEN_LIFETIME_MINUTES=30
REFRESH_TOKEN_LIFETIME_DAYS=7

# Docker Compose
# Host port for the web container
WEB_PORT=8000
# Image name/tag built by compose
# IMAGE_NAME=logistic-api
# IMAGE_TAG=local
